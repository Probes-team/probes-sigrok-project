# -- sigrok protocol data values file --
# -- sigrok protocol data header start --
protocol=spi
bitrate=1000000
textinput=yes
# -- sigrok protocol data header end --
# Synthetic SPI protocol-data fixture for the A7105 decoder.
# Generated manually from the A7105 command encoding; sample rate 1 MHz.
# Channels generated by protocoldata: sck, miso, mosi, cs (mode 0, MSB first).
# textinput: radix=16
# spi: cs-assert
# spi: mosi-then-miso
0e 00
ab 00
# spi: cs-release
# FIFO write with a separate CS boundary.
# spi: cs-assert
# spi: mosi-then-miso
05 00
12 00
34 00
# spi: cs-release
# Register read (0x4e selects DATA_RATE) with a synthetic MISO value.
# spi: cs-assert
# spi: mosi-then-miso
4e 00
55 7c
# spi: cs-release
