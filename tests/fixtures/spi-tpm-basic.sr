# -- sigrok protocol data values file --
# -- sigrok protocol data header start --
protocol=spi
bitrate=1000000
textinput=yes
# -- sigrok protocol data header end --
# Synthetic SPI protocol-data fixture for the SPI TPM decoder.
# Generated manually from TPM 2.0 SPI framing; sample rate 1 MHz.
# Channels generated by protocoldata: sck, miso, mosi, cs (mode 0, MSB first).
# It contains a read with one wait state and a write. Bytes are non-secret test values.
# textinput: radix=16
# Read one byte from TPM_DATA_FIFO_0 (address 0x000024): one zero wait then 0x01 ready.
# spi: cs-assert
# spi: mosi-then-miso
80 00
00 00
00 00
24 00
00 00
00 01
00 5a
# spi: cs-release
# Write two non-secret test bytes to address 0x000018.
# spi: cs-assert
# spi: mosi-then-miso
01 00
00 00
00 00
18 00
00 01
18 00
c3 00
# spi: cs-release
# spi: cs-assert
# spi: mosi-then-miso
# spi: cs-release
# spi: cs-assert
# spi: mosi-then-miso
# spi: cs-release
